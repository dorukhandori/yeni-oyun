# Copy to .env.local (gitignored). Fill values locally. Never commit secrets,
# never paste them into chat.
#
# If left empty, scripts/gen-assets.mjs falls back to the key already
# configured in ../game-project/.env.local — you likely don't need to fill
# this file in at all right now.

# Google AI Studio / Generative Language — image (Nano Banana) + video (Veo).
GEMINI_API_KEY=
# Optional second key if the primary hits quota or is suspended.
GEMINI_API_KEY_FALLBACK=
# Optional alias, also checked.
GOOGLE_API_KEY=

# Meshy OpenAPI (`scripts/gen-meshy.mjs`) — retexture the Tripo Doryseus GLB
# with the 4-view sprites so the nape is the back still, not another face.
# https://www.meshy.ai → API keys. Never paste the key in chat.
MESHY_API_KEY=
# Never paste this into chat. Create at https://platform.tripo3d.ai — OpenAPI v3 key.
# Studio (tripo3d.ai) credits do NOT fill this wallet — they are separate.
TRIPO_API_KEY=

# ---------------------------------------------------------------------------
# K35 "Beş yeter" online speedrun leaderboard (src/net/leaderboard.ts).
# UNLIKE EVERY KEY ABOVE, these two are VITE_-prefixed, which means Vite inlines
# them into the client bundle. That is correct here and only here:
#   - VITE_SUPABASE_URL is public by nature.
#   - VITE_SUPABASE_ANON_KEY is a JWT with role "anon", designed to be
#     published; the security boundary is Postgres RLS, not secrecy.
# NEVER put the Supabase `service_role` key here or anywhere in src/ — it
# bypasses RLS entirely.
#
# Leave both empty and the game runs fine with the leaderboard switched off
# (isLeaderboardEnabled() === false, zero network calls).
# Setup walkthrough: scripts/supabase/README.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
