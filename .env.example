# Copy to .env.local (gitignored). Fill values locally. Never commit secrets,
# never paste them into chat.
#
# If left empty, scripts/gen-assets.mjs falls back to the key already
# configured in ../game-project/.env.local — you likely don't need to fill
# this file in at all right now.

# Google AI Studio / Generative Language — image (Nano Banana) + video (Veo).
GEMINI_API_KEY=
# Optional second key if the primary hits quota or is suspended.
GEMINI_API_KEY_FALLBACK=
# Optional alias, also checked.
GOOGLE_API_KEY=
