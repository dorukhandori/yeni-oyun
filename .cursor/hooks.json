{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/ccgs-session-start.sh",
        "timeout": 15
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/ccgs-session-end.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/ccgs-session-end.sh",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/ccgs-before-shell.sh",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/ccgs-after-edit.sh",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/ccgs-subagent-start.sh",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/ccgs-subagent-stop.sh",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/ccgs-pre-compact.sh",
        "timeout": 10
      }
    ]
  }
}
